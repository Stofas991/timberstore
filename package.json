{
  "name": "timberstore",
  "version": "0.4.0",
  "private": true,
  "description": "Custom frontend and backend code for timberstore.sk (Shoptet)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src shared scripts",
    "format": "prettier --write .",
    "release": "npm version minor",
    "release:patch": "npm version patch",
    "release:rc": "npm version preminor --preid rc",
    "release:rc:next": "npm version prerelease --preid rc",
    "version": "npm run lint && npm run build && git add dist",
    "postversion": "git push --follow-tags && npm run wait-cdn",
    "wait-cdn": "node scripts/wait-cdn.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0"
  }
}
